# TikTato (petiht.com/tiktato)
Options -Indexes -MultiViews
DirectoryIndex index.php

# Schema, docs and dotfiles are never served.
<FilesMatch "\.(sql|md|lock|log|ini|sh|bak)$|^\.|^composer\.(json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# PHP output is per-user and live: never cacheable, even if a script dies before
# sending its own headers (the host's default would otherwise be public for 2 days).
# Versioned static assets (?v=) can be cached for a long time.
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
        Header always unset Expires
    </FilesMatch>
    <FilesMatch "\.(css|js|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
